<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6FA">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A3A5C"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="32dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@mipmap/ic_launcher"
            android:background="@drawable/bg_logo"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Emes Exam Browser"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Safe browsing untuk ujian online"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URL UJIAN"
                android:textColor="#6B7280"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- URL input row with scan button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etUrl"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="https://ujian.sekolah.id/..."
                    android:inputType="textUri"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />

                <Button
                    android:id="@+id/btnScanQr"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="📷"
                    android:textSize="20sp"
                    android:padding="0dp" />

            </LinearLayout>

            <!-- Label scan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="atau scan QR Code dari pengawas"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_primary"
                android:text="▶  Mulai Ujian"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Info card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡  Fitur Keamanan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1A3A5C"
                    android:layout_marginBottom="8dp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="✓  Tombol Back &amp; Home diblokir" android:textSize="13sp" android:textColor="#374151" android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="✓  Fullscreen tanpa gangguan" android:textSize="13sp" android:textColor="#374151" android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="✓  Keluar hanya dengan PIN pengawas" android:textSize="13sp" android:textColor="#374151" android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="✓  Scan QR Code URL ujian" android:textSize="13sp" android:textColor="#374151" android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="✓  Tidak ada iklan" android:textSize="13sp" android:textColor="#374151"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
